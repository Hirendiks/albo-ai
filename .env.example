# ===================================================
# ALBO AI - ENVIRONMENT VARIABLES
# ===================================================

# 1. Google Gemini AI API Key (FREE: 1,500 requests/day at https://aistudio.google.com/)
# Used on the server to analyze scraped pages, extract contacts, and generate AI TL;DRs.
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Upstash Redis Serverless REST API (FREE: 10,000 commands/day at https://upstash.com/)
# Used in production on Vercel for permanent multi-user cloud library synchronization.
# Note: Vercel KV also automatically populates KV_REST_API_URL and KV_REST_API_TOKEN.
UPSTASH_REDIS_REST_URL=https://your-database-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# 3. Application Public URL (Optional)
NEXT_PUBLIC_APP_URL=https://your-albo-app.vercel.app

# 4. Google One-Tap & Direct 1-Click Sign-In (FREE from https://console.cloud.google.com/)
# Optional: Set this to enable the official 1-click Google account chooser popup!
# Without it, Albo uses the built-in instant Gmail sign-in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

